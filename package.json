{
  "name": "countbase-sdk-web",
  "version": "26.1.2",
  "description": "Countbase Web SDK: analytics, crash reporting and feedback for websites (based on the Countly Web SDK)",
  "main": "lib/countbase.js",
  "types": "lib/countbase.d.ts",
  "directories": {
    "example": "examples",
    "lib": "lib",
    "test": "test"
  },
  "scripts": {
    "docs": "node_modules/.bin/jsdoc lib/countbase.js README.md -c jsdoc_conf.json -d docs",
    "build": "webpack",
    "lint": "./node_modules/.bin/eslint --ignore-path .eslintignore --fix .",
    "lintMD": "markdownlint **/*.md --fix",
    "cy:open": "cypress open",
    "cy:run": "cypress run --spec 'cypress/e2e/device_id_change.cy.js'",
    "pretest": "eslint --ignore-path .eslintignore .",
    "test": "cypress run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aviral-zype/countbase-sdk-web.git"
  },
  "keywords": [
    "countbase",
    "analytics",
    "web",
    "sdk"
  ],
  "author": "Countbase",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/aviral-zype/countbase-sdk-web/issues"
  },
  "homepage": "https://github.com/aviral-zype/countbase-sdk-web#readme",
  "devDependencies": {
    "cypress": "13.6.0",
    "cypress-localstorage-commands": "2.2.5",
    "eslint": "8.37.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-plugin-chai-friendly": "0.7.2",
    "eslint-plugin-cypress": "2.13.2",
    "eslint-plugin-import": "2.27.5",
    "jsdoc": "4.0.2",
    "markdownlint": "0.29.0",
    "stylelint": "14.9.1",
    "stylelint-config-standard": "28.0.0"
  },
  "npmName": "countbase-sdk-web",
  "npmFileMap": [
    {
      "basePath": "lib",
      "files": [
        "countbase.min.js"
      ]
    }
  ],
  "files": [
    "lib/",
    "plugin/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
